{
  "expo": {
    "name": "CleanOps",
    "slug": "cleanops",
    "version": "1.0.0",
    "description": "CleanOps — the operations hub for cleaning companies, cleaners, homeowners and landlords. Live job map, driver mode, teams, payroll and more.",
    "primaryColor": "#1A5F7A",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cleanops",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show cleaning jobs near you while online"
      },
      "bundleIdentifier": "com.emergent.qualifiedcleaners.o0d27x"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A5F7A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "app.emergent.cleanops7f747ca7"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
